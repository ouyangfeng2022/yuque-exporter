{
  "manifest_version": 3,
  "name": "语雀知识库批量导出",
  "version": "2.0.0",
  "description": "一款用于批量导出语雀知识库文档的浏览器扩展，无需任何手动配置。",
  "permissions": [
    "activeTab",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "https://www.yuque.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.yuque.com/*"
      ],
      "js": [
        "content.js",
        "ui.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"],
      "matches": ["https://www.yuque.com/*"]
    }
  ]
}
